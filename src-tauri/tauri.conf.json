{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightfall Blade",
  "version": "1.0.0",
  "identifier": "com.nightfallblade.game",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Nightfall Blade",
    "category": "Game",
    "shortDescription": "Neon pixel arcade combat",
    "longDescription": "Fast-paced 2D pixel-art dark fantasy arcade combat against waves of enemies and multi-phase bosses with neon weapon upgrades.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
